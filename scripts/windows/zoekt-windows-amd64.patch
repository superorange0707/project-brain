+// limitations under the License.
+
+//go:build windows
+
+package index
+
+import (
+	"fmt"
+	"math"
+	"os"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// mmapedIndexFile is the Windows equivalent of Zoekt's Unix mmap reader.
+// File-backed pages are faulted on demand instead of copying every shard into
+// the Go heap, so resident memory remains controlled by the operating system.
+type mmapedIndexFile struct {
+	name    string
+	size    uint32
+	mapping windows.Handle
+	address uintptr
+	data    []byte
+}
+
+func (f *mmapedIndexFile) Read(off, sz uint32) ([]byte, error) {
+	if off > off+sz || off+sz > uint32(len(f.data)) {
+		return nil, fmt.Errorf("out of bounds: %d, len %d, name %s", off+sz, len(f.data), f.name)
+	}
+	return f.data[off : off+sz], nil
+}
+
+func (f *mmapedIndexFile) Name() string { return f.name }
+
+func (f *mmapedIndexFile) Size() (uint32, error) { return f.size, nil }
+
+func (f *mmapedIndexFile) Close() {
+	if f.address != 0 {
+		_ = windows.UnmapViewOfFile(f.address)
+		f.address = 0
+		f.data = nil
+	}
+	if f.mapping != 0 {
+		_ = windows.CloseHandle(f.mapping)
+		f.mapping = 0
+	}
+}
+
+// NewIndexFile takes ownership of f and maps the immutable shard read-only.
+func NewIndexFile(f *os.File) (IndexFile, error) {
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if info.Size() < 0 || info.Size() >= math.MaxUint32 {
+		return nil, fmt.Errorf("file %s too large: %d", f.Name(), info.Size())
+	}
+	size := uint32(info.Size())
+	mapping, err := windows.CreateFileMapping(
+		windows.Handle(f.Fd()), nil, windows.PAGE_READONLY, 0, 0, nil,
+	)
+	if err != nil {
+		return nil, err
+	}
+	address, err := windows.MapViewOfFile(mapping, windows.FILE_MAP_READ, 0, 0, uintptr(size))
+	if err != nil {
+		_ = windows.CloseHandle(mapping)
+		return nil, err
+	}
+	data := unsafe.Slice((*byte)(unsafe.Pointer(address)), int(size))
+	return &mmapedIndexFile{
+		name: f.Name(), size: size, mapping: mapping, address: address, data: data,
+	}, nil
+}
